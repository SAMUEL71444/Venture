# Salin file ini jadi `.env.local` lalu isi nilainya dari dashboard Supabase.
# (.env.local tidak di-commit — sudah diabaikan .gitignore)
#
# Ambil di: Supabase Dashboard → Settings → API
#   - Project URL           → NEXT_PUBLIC_SUPABASE_URL
#   - Project API keys: anon public → NEXT_PUBLIC_SUPABASE_ANON_KEY

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nama bucket Storage untuk file sensitif (KTM, hasil kerja). Sudah kamu buat.
NEXT_PUBLIC_SUPABASE_PRIVATE_BUCKET=digitalin-private
